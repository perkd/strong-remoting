{
  "name": "strong-remoting",
  "description": "StrongLoop Remoting Module",
  "keywords": [
    "StrongLoop",
    "LoopBack",
    "Remoting",
    "REST"
  ],
  "author": "IBM Corp.",
  "version": "3.20.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "coverage": "nyc report --reporter=text-lcov | coveralls",
