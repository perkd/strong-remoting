    "axios": "^1.10.0",
    "body-parser": "^2.2.0",
    "debug": "^4.4.1",
    "depd": "^2.0.0",
    "escape-string-regexp": "4.0.0",
    "eventemitter2": "^6.4.9",
    "express": "^5.1.0",
    "inflection": "2.0.1",
    "jayson": "2.1.2",
    "js2xmlparser": "4.0.1",
    "loopback-datatype-geopoint": "^1.0.0",
    "loopback-phase": "^3.4.0",
    "mux-demux": "^3.7.9",
    "qs": "^6.14.0",
    "request": "^2.88.2",
    "sse": "0.0.8",
    "strong-error-handler": "3.5.0",
    "strong-globalize": "6.0.6",
    "traverse": "^0.6.11",
    "xml2js": "0.4.23"
  },
  "devDependencies": {
    "chai": "4.5.0",
    "coveralls": "^3.1.1",
    "dirty-chai": "^2.0.1",
    "eslint": "^9.30.1",
    "eslint-config-loopback": "^13.1.0",
    "event-stream": "^4.0.1",
    "eventsource": "1.1.2",
    "http-auth": "3.2.4",
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "requirejs": "^2.3.7",
    "socket.io": "^4.8.1",
    "supertest": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/strongloop/strong-remoting"
  },
  "browser": {
    "body-parser": false,
    "express": false,
    "js2xmlparser": false,
    "strong-error-handler": false
  },
  "license": "Artistic-2.0",
  "packageManager": "yarn@4.9.2"
