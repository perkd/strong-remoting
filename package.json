{
  "name": "strong-remoting",
  "description": "StrongLoop Remoting Module",
  "keywords": [
    "StrongLoop",
    "LoopBack",
    "Remoting",
    "REST"
  ],
  "author": "IBM Corp.",
  "version": "3.20.3",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "coverage": "node scripts/coverage-reporter.js",
    "coverage:html": "node scripts/coverage-reporter.js --format html --open",
    "coverage:text": "c8 report --reporter=text",
    "coverage:lcov": "c8 report --reporter=lcov",
    "coverage:json": "c8 report --reporter=json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "npm audit --audit-level=moderate",
    "security:check": "npm audit --audit-level=high",
    "test": "c8 mocha",
    "test:modern": "node scripts/test-runner.js",
    "test:native": "node --test --test-reporter=spec test/**/*.test.js",
    "test:watch": "node scripts/test-runner.js --watch",
    "test:coverage": "c8 --reporter=text --reporter=html node --test test/**/*.test.js",
    "test:security": "npm run security:audit && npm test",
    "posttest": "npm run lint",
    "reinstall": "(rm -rf node_modules/ || true) && (rm yarn.lock || true) && yarn install"
  },
  "dependencies": {
    "async": "^3.2.6",
    "axios": "^1.10.0",
    "body-parser": "^2.2.0",
    "debug": "^4.4.1",
    "depd": "^2.0.0",
    "escape-string-regexp": "4.0.0",
    "eventemitter2": "^6.4.9",
    "express": "^5.1.0",
    "inflection": "2.0.1",
    "jayson": "2.1.2",
    "js2xmlparser": "4.0.1",
    "loopback-datatype-geopoint": "^1.0.0",
    "loopback-phase": "^3.4.0",
    "mux-demux": "^3.7.9",
    "qs": "^6.14.0",
    "sse": "0.0.8",
    "strong-error-handler": "3.5.0",
    "strong-globalize": "6.0.6",
    "traverse": "^0.6.11",
    "xml2js": "^0.6.2"
  },
  "devDependencies": {
    "c8": "^10.1.3",
    "chai": "4.5.0",
    "dirty-chai": "^2.0.1",
    "eslint": "^9.30.1",
    "eslint-config-loopback": "^13.1.0",
    "event-stream": "^4.0.1",
    "eventsource": "1.1.2",
    "glob": "^11.0.3",
    "http-auth": "3.2.4",
    "mocha": "^11.7.1",
    "nyc": "^17.1.0",
    "requirejs": "^2.3.7",
    "socket.io": "^4.8.1",
    "supertest": "^7.1.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/strongloop/strong-remoting"
  },
  "browser": {
    "body-parser": false,
    "express": false,
    "js2xmlparser": false,
    "strong-error-handler": false
  },
  "license": "Artistic-2.0",
  "packageManager": "yarn@4.9.2"
}
