{
  "name": "@perkd/strong-remoting",
  "version": "3.22.0",
  "description": "StrongLoop Remoting Module",
  "keywords": [
    "StrongLoop",
    "LoopBack",
    "Remoting",
    "REST"
  ],
  "author": "IBM Corp.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "coverage": "node scripts/coverage-reporter.js",
    "coverage:html": "node scripts/coverage-reporter.js --format html --open",
    "coverage:text": "c8 report --reporter=text",
    "coverage:lcov": "c8 report --reporter=lcov",
    "coverage:json": "c8 report --reporter=json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "security:audit": "yarn audit --audit-level=moderate",
    "security:check": "yarn audit --audit-level=high",
    "test": "yarn test:unit && yarn test:e2e",
    "test:unit": "c8 node --test --test-force-exit --test-reporter=spec tests/*.test.js tests/rest-coercion/*.suite.js",
    "test:e2e": "node scripts/e2e-test-runner.js",
    "test:watch": "node scripts/test-runner.js --watch",
    "test:security": "yarn audit --audit-level=moderate && yarn test",
    "reinstall": "(rm -rf node_modules/ || true) && (rm yarn.lock || true) && yarn install"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "better-sse": "^0.16.1",
    "body-parser": "^2.3.0",
    "debug": "^4.4.3",
    "depd": "^2.0.0",
    "eventemitter2": "^6.4.9",
    "express": "^5.2.1",
    "inflection": "^3.0.2",
    "jayson": "^4.3.0",
    "js2xmlparser": "4.0.2",
    "loopback-datatype-geopoint": "^1.0.0",
    "loopback-phase": "^3.4.0",
    "mux-demux": "^3.7.9",
    "qs": "^6.15.3",
    "strong-error-handler": "3.5.0",
    "strong-globalize": "6.0.6",
    "traverse": "^0.6.11"
  },
  "devDependencies": {
    "c8": "^12.0.0",
    "eslint": "^10.8.1",
    "eslint-config-loopback": "^14.0.0",
    "event-stream": "^4.0.1",
    "eventsource": "1.1.2",
    "glob": "^13.0.6",
    "http-auth": "^4.2.1",
    "http-auth-connect": "^1.0.6",
    "socket.io": "^4.8.3"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/perkd/strong-remoting.git"
  },
  "browser": {
    "body-parser": false,
    "express": false,
    "js2xmlparser": false,
    "strong-error-handler": false
  },
  "license": "Artistic-2.0",
  "packageManager": "yarn@4.18.0",
  "bugs": {
    "url": "https://github.com/perkd/strong-remoting/issues"
  },
  "homepage": "https://github.com/perkd/strong-remoting#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "README.md",
    "LICENSE.md",
    "index.js",
    "lib",
    "ext",
    "intl"
  ]
}
